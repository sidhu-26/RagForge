# ==============================================================================
# RAGForge Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local development.
# ==============================================================================

# Application Environment: development | staging | production
RAGFORGE_ENVIRONMENT=development

# Logging Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
RAGFORGE_LOG_LEVEL=INFO

# Server Host & Port
RAGFORGE_HOST=0.0.0.0
RAGFORGE_PORT=8000

# API Prefix
RAGFORGE_API_V1_PREFIX=/api/v1

# CORS Allowed Origins (Comma-separated list or JSON array; defaults to empty / same-origin)
# Example: RAGFORGE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
RAGFORGE_CORS_ORIGINS=[]

# PostgreSQL Database Connection URL (Asyncpg driver)
# Note: SQLAlchemy async PostgreSQL requires the 'postgresql+asyncpg://' driver scheme.
RAGFORGE_DATABASE_URL=postgresql+asyncpg://ragforge_user:ragforge_password@localhost:5432/ragforge_db

# PostgreSQL Connection Pooling & Engine Tuning
RAGFORGE_DB_POOL_SIZE=5
RAGFORGE_DB_MAX_OVERFLOW=10
RAGFORGE_DB_POOL_TIMEOUT=30.0
RAGFORGE_DB_POOL_RECYCLE=1800
RAGFORGE_DB_POOL_PRE_PING=true
RAGFORGE_DB_ECHO=false

# Application Secret Key (Used for cryptographic hashing / sessions in future milestones)
RAGFORGE_SECRET_KEY=dev_insecure_secret_key_change_in_production_min32chars

# Document Storage Settings
RAGFORGE_STORAGE_LOCAL_ROOT=data/storage
RAGFORGE_STORAGE_MAX_UPLOAD_SIZE_BYTES=26214400
RAGFORGE_STORAGE_CHUNK_SIZE_BYTES=65536

# Redis and ARQ Queue Configuration
RAGFORGE_REDIS_URL=redis://localhost:6379/0
RAGFORGE_QUEUE_JOB_TIMEOUT_SECONDS=300
RAGFORGE_WORKER_MAX_TRIES=3

# Text Extraction Bounds
RAGFORGE_EXTRACTION_MAX_PAGES=500
RAGFORGE_EXTRACTION_MAX_TEXT_SIZE_BYTES=10485760

# Chunking Configuration
RAGFORGE_CHUNK_TARGET_SIZE=1000
RAGFORGE_CHUNK_OVERLAP=150
RAGFORGE_CHUNK_MIN_SIZE=50
RAGFORGE_MAX_CHUNKS_PER_DOCUMENT=2000

# Embedding Provider Configuration: local | azure | fake
RAGFORGE_EMBEDDING_PROVIDER=local
RAGFORGE_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAGFORGE_EMBEDDING_DIMENSION=384
RAGFORGE_EMBEDDING_BATCH_SIZE=32
RAGFORGE_EMBEDDING_MAX_INPUT_CHARS=8192
RAGFORGE_EMBEDDING_REQUEST_TIMEOUT_SECONDS=30.0
RAGFORGE_EMBEDDING_MAX_RETRIES=3

# Azure OpenAI Embedding Configuration (Optional; required only if RAGFORGE_EMBEDDING_PROVIDER=azure)
# RAGFORGE_AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# RAGFORGE_AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
# RAGFORGE_AZURE_OPENAI_API_VERSION=2024-02-01
# RAGFORGE_AZURE_OPENAI_DEPLOYMENT_NAME=text-embedding-3-small

# Semantic Retrieval Bounds
RAGFORGE_RETRIEVAL_DEFAULT_LIMIT=5
RAGFORGE_RETRIEVAL_MAX_LIMIT=50

# ==============================================================================
# SLM / Answer Generation Configuration (Milestone 6)
# ==============================================================================
# Generation Provider: fake | azure | gemini
RAGFORGE_GENERATION_PROVIDER=fake
RAGFORGE_GENERATION_MODEL=gpt-4o-mini
RAGFORGE_GENERATION_MAX_OUTPUT_TOKENS=1024
RAGFORGE_GENERATION_TEMPERATURE=0.0
RAGFORGE_GENERATION_REQUEST_TIMEOUT_SECONDS=45.0
RAGFORGE_GENERATION_MAX_RETRIES=3

# Azure OpenAI Chat/Completions Deployment (Required only if RAGFORGE_GENERATION_PROVIDER=azure)
# RAGFORGE_AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o-mini

# Google Gemini Generation Configuration (Required only if RAGFORGE_GENERATION_PROVIDER=gemini)
# Obtain a Gemini API key from Google AI Studio: https://aistudio.google.com/
# Free-tier terms allow Google to use prompts/responses for model training. Review data handling terms before using sensitive data.
# RAGFORGE_GEMINI_API_KEY=your_gemini_api_key_here
# RAGFORGE_GEMINI_MODEL=gemini-2.5-flash

# Question Answering & Context Bounds
RAGFORGE_ASK_MAX_QUESTION_CHARS=1000
RAGFORGE_ASK_DEFAULT_RETRIEVAL_LIMIT=5
RAGFORGE_ASK_MAX_EVIDENCE_TOTAL_CHARS=12000
RAGFORGE_ASK_MIN_SIMILARITY_THRESHOLD=0.40