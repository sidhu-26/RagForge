# ==============================================================================
# RAGForge Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local development.
# ==============================================================================

# Application Environment: development | staging | production
RAGFORGE_ENVIRONMENT=development

# Logging Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
RAGFORGE_LOG_LEVEL=INFO

# Server Host & Port
RAGFORGE_HOST=0.0.0.0
RAGFORGE_PORT=8000

# API Prefix
RAGFORGE_API_V1_PREFIX=/api/v1

# CORS Allowed Origins (Comma-separated list or JSON array; defaults to empty / same-origin)
# Example: RAGFORGE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
RAGFORGE_CORS_ORIGINS=[]

# PostgreSQL Database Connection URL (Asyncpg driver)
# Note: SQLAlchemy async PostgreSQL requires the 'postgresql+asyncpg://' driver scheme.
RAGFORGE_DATABASE_URL=postgresql+asyncpg://ragforge_user:ragforge_password@localhost:5432/ragforge_db

# PostgreSQL Connection Pooling & Engine Tuning
RAGFORGE_DB_POOL_SIZE=5
RAGFORGE_DB_MAX_OVERFLOW=10
RAGFORGE_DB_POOL_TIMEOUT=30.0
RAGFORGE_DB_POOL_RECYCLE=1800
RAGFORGE_DB_POOL_PRE_PING=true
RAGFORGE_DB_ECHO=false

# Application Secret Key (Used for cryptographic hashing / sessions in future milestones)
RAGFORGE_SECRET_KEY=dev_insecure_secret_key_change_in_production_min32chars

# Document Storage Settings
RAGFORGE_STORAGE_LOCAL_ROOT=data/storage
RAGFORGE_STORAGE_MAX_UPLOAD_SIZE_BYTES=26214400
RAGFORGE_STORAGE_CHUNK_SIZE_BYTES=65536

# Redis and ARQ Queue Configuration
RAGFORGE_REDIS_URL=redis://localhost:6379/0
RAGFORGE_QUEUE_JOB_TIMEOUT_SECONDS=300
RAGFORGE_WORKER_MAX_TRIES=3

# Text Extraction Bounds
RAGFORGE_EXTRACTION_MAX_PAGES=500
RAGFORGE_EXTRACTION_MAX_TEXT_SIZE_BYTES=10485760

# Chunking Configuration
RAGFORGE_CHUNK_TARGET_SIZE=1000
RAGFORGE_CHUNK_OVERLAP=150
RAGFORGE_CHUNK_MIN_SIZE=50
RAGFORGE_MAX_CHUNKS_PER_DOCUMENT=2000
